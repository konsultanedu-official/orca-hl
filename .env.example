# latest = newest upstream Orca release that passed this repository's CI tests.
# For a pinned production deployment, use an exact version such as 1.4.199.
ORCA_TAG=latest

# Optional override if you publish/mirror the image elsewhere (for example Docker Hub).
ORCA_IMAGE=ghcr.io/konsultanedu-official/orca-hl

# Public/LAN/Tailscale/reverse-proxy endpoint advertised to Orca clients.
ORCA_PAIRING_ADDRESS=wss://orca.example.com

# Used only with docker-compose.host.yml for aaPanel/plain Docker/Portainer hosts.
ORCA_BIND_ADDRESS=127.0.0.1
ORCA_HOST_PORT=6768

# Optional OpenCode -> self-hosted 9Router provider.
# Set these at runtime through your orchestrator/host environment. On a fresh
# OpenCode config volume the container creates a portable provider config that
# references these variables; the API key value itself is never written into
# the image or committed configuration.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Credentials are intentionally NOT stored in the image or repository.
# Authenticate interactively into the persistent volumes, or add secrets through
# your orchestrator at runtime (for example GH_TOKEN, OPENAI_API_KEY,
# ANTHROPIC_API_KEY, NINEROUTER_API_KEY) when your chosen authentication flow
# requires them.
