# latest = newest upstream Orca release that passed this repository's CI tests.
# For a pinned production deployment, use an exact version such as 1.4.198.
ORCA_TAG=latest

# Optional override if you publish/fork the image elsewhere.
ORCA_IMAGE=ghcr.io/konsultanedu-official/orca-hl

# Public/LAN/Tailscale/reverse-proxy endpoint advertised to Orca clients.
ORCA_PAIRING_ADDRESS=wss://orca.example.com
